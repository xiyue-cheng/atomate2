   fi

   deff_0_down=$(echo "scale=5; sqrt($dtemp_0_down)" |bc)

   dtemp_1_down=$(echo "scale=5; (19/105*($d11_1_down^2+$d22_1_down^2+$d33_1_down^2)+13/105*($d11_1_down*$d12_1_down+$d11_1_down*$d13_1_down+$d22_1_down*$d21_1_down+$d22_1_down*$d23_1_down+$d33_1_down*$d31_1_down+$d33_1_down*$d32_1_down)+44/105*($d16_1_down^2+$d15_1_down^2+$d26_1_down^2+$d24_1_down^2+$d35_1_down^2+$d34_1_down^2)+13/105*($d16_1_down*$d23_1_down+$d15_1_down*$d32_1_down+$d26_1_down*$d13_1_down+$d24_1_down*$d31_1_down+$d35_1_down*$d12_1_down+$d34_1_down*$d21_1_down)+5/7*(($d14_1_down+$d25_1_down+$d36_1_down)/3)^2)" |bc)

   if [ $(awk -v x=$dtemp_1_down 'BEGIN{print(x<0)?"1":"0"}') -eq 1 ];then
   dtemp_1_down=$(awk -v x=$dtemp_1_down 'BEGIN{printf("%.5f", 0-x)}')
   fi

   deff_1_down=$(echo "scale=5; sqrt($dtemp_1_down)" |bc)

   echo " " 
   echo "deff for spin down at omege = 0 eV"
   printf "%.3f \n" $deff_0_down

   echo "deff for spin down at omege = 1.167 eV"
   printf "%.3f \n" $deff_1_down

   echo "d for spin down at omege = 0 eV"
   printf "%.3f %.3f %.3f %.3f %.3f %.3f\n" $d11_0_down $d12_0_down $d13_0_down $d14_0_down $d15_0_down $d16_0_down 
   printf "%.3f %.3f %.3f %.3f %.3f %.3f\n" $d21_0_down $d22_0_down $d23_0_down $d24_0_down $d25_0_down $d26_0_down
   printf "%.3f %.3f %.3f %.3f %.3f %.3f\n" $d31_0_down $d32_0_down $d33_0_down $d34_0_down $d35_0_down $d36_0_down

   echo "d for spin down at omege = $w_energy eV"
   printf "%.3f %.3f %.3f %.3f %.3f %.3f\n" $d11_1_down $d12_1_down $d13_1_down $d14_1_down $d15_1_down $d16_1_down
   printf "%.3f %.3f %.3f %.3f %.3f %.3f\n" $d21_1_down $d22_1_down $d23_1_down $d24_1_down $d25_1_down $d26_1_down
   printf "%.3f %.3f %.3f %.3f %.3f %.3f\n" $d31_1_down $d32_1_down $d33_1_down $d34_1_down $d35_1_down $d36_1_down

   cd ../out_lin

   e11_0_down=$(awk 'NR=='8' {printf("%.5f\n", $3*1) }' lin_xx_down.dat)
   e22_0_down=$(awk 'NR=='8' {printf("%.5f\n", $3*1) }' lin_yy_down.dat)
   e33_0_down=$(awk 'NR=='8' {printf("%.5f\n", $3*1) }' lin_zz_down.dat)

   e11_iw_down=$(awk 'NR=='$n_we' {printf("%.5f\n", $2*1) }' lin_xx_down.dat)
   e22_iw_down=$(awk 'NR=='$n_we' {printf("%.5f\n", $2*1) }' lin_yy_down.dat)
   e33_iw_down=$(awk 'NR=='$n_we' {printf("%.5f\n", $2*1) }' lin_zz_down.dat)

   e11_rw_down=$(awk 'NR=='$n_we' {printf("%.5f\n", $3*1) }' lin_xx_down.dat)
   e22_rw_down=$(awk 'NR=='$n_we' {printf("%.5f\n", $3*1) }' lin_yy_down.dat)
   e33_rw_down=$(awk 'NR=='$n_we' {printf("%.5f\n", $3*1) }' lin_zz_down.dat)

   n11_0_down=$(echo "scale=5; sqrt((sqrt($e11_0_down^2)+$e11_0_down)/2)" |bc)
   n22_0_down=$(echo "scale=5; sqrt((sqrt($e22_0_down^2)+$e22_0_down)/2)" |bc)
   n33_0_down=$(echo "scale=5; sqrt((sqrt($e33_0_down^2)+$e33_0_down)/2)" |bc)

   n11_w_down=$(echo "scale=5; sqrt((sqrt($e11_iw_down^2+$e11_rw_down^2)+$e11_rw_down)/2)" |bc)
   n22_w_down=$(echo "scale=5; sqrt((sqrt($e22_iw_down^2+$e22_rw_down^2)+$e22_rw_down)/2)" |bc)
   n33_w_down=$(echo "scale=5; sqrt((sqrt($e33_iw_down^2+$e33_rw_down^2)+$e33_rw_down)/2)" |bc)

   #birefringence
   a=$n11_0_down
   b=$n22_0_down
   c=$n33_0_down

   if [ $(echo "$a > $b" | bc) = 1 ];then
      t=$a;a=$b;b=$t;
   fi

   if [ $(echo "$a > $c" | bc) = 1 ];then
      t=$a;a=$c;c=$t;
   fi

   if [ $(echo "$b > $c" | bc) = 1 ];then
      t=$b;b=$c;c=$t;
   fi

   delta_n_down=$(echo "scale=5; $c-$a" |bc)

   #birefringence
   a=$n11_w_down
   b=$n22_w_down
   c=$n33_w_down

   if [ $(echo "$a > $b" | bc) = 1 ];then
      t=$a;a=$b;b=$t;
   fi

   if [ $(echo "$a > $c" | bc) = 1 ];then
      t=$a;a=$c;c=$t;
   fi

   if [ $(echo "$b > $c" | bc) = 1 ];then
      t=$b;b=$c;c=$t;
   fi

   delta_nw_down=$(echo "scale=5; $c-$a" |bc)

   echo "linear optic epsilon for spin down at 0 eV"
   printf "%.3f %.3f %.3f \n" $e11_0_down $e22_0_down $e33_0_down
   echo "refractive n for spin down at 0 eV"
   printf "%.3f %.3f %.3f \n" $n11_0_down $n22_0_down $n33_0_down
   echo "birefringence for spin down at 0 eV" 
   printf "%.3f \n" $delta_n_down
   echo "refractive n for spin down at $w_energy eV"
   printf "%.3f %.3f %.3f \n" $n11_w_down $n22_w_down $n33_w_down
   echo "birefringence for spin down at $w_energy eV" 
   printf "%.3f \n" $delta_nw_down

   cd ../

   echo "deff for spin down at omege = 0 eV" >> result_down.re
   printf "%.3f \n" $deff_0_down >> result_down.re
   echo " " >> result_down.re

   echo "deff for spin down at omege = 1.167 eV" >> result_down.re
   printf "%.3f \n" $deff_1_down >> result_down.re
   echo " " >> result_down.re

   echo "d for spin down at omege = 0 eV" >> result_down.re
   printf "%.3f %.3f %.3f %.3f %.3f %.3f\n" $d11_0_down $d12_0_down $d13_0_down $d14_0_down $d15_0_down $d16_0_down >> result_down.re
   printf "%.3f %.3f %.3f %.3f %.3f %.3f\n" $d21_0_down $d22_0_down $d23_0_down $d24_0_down $d25_0_down $d26_0_down >> result_down.re
   printf "%.3f %.3f %.3f %.3f %.3f %.3f\n" $d31_0_down $d32_0_down $d33_0_down $d34_0_down $d35_0_down $d36_0_down >> result_down.re
   echo " ">> result_down.re

   echo "d for spin down at omege = $w_energy eV" >> result_down.re
   printf "%.3f %.3f %.3f %.3f %.3f %.3f\n" $d11_1_down $d12_1_down $d13_1_down $d14_1_down $d15_1_down $d16_1_down >> result_down.re
   printf "%.3f %.3f %.3f %.3f %.3f %.3f\n" $d21_1_down $d22_1_down $d23_1_down $d24_1_down $d25_1_down $d26_1_down >> result_down.re
   printf "%.3f %.3f %.3f %.3f %.3f %.3f\n" $d31_1_down $d32_1_down $d33_1_down $d34_1_down $d35_1_down $d36_1_down >> result_down.re

   echo " " >> result_down.re
   echo "linear optic epsilon for spin down at 0 eV" >> result_down.re
   printf "%.3f %.3f %.3f \n" $e11_0_down $e22_0_down $e33_0_down >> result_down.re

   echo " " >> result_down.re
   echo "refractive n for spin down at 0 eV" >> result_down.re
   printf "%.3f %.3f %.3f \n" $n11_0_down $n22_0_down $n33_0_down >> result_down.re

   echo " " >> result_down.re
   echo "birefringence for spin down at 0 eV" >> result_down.re
   printf "%.3f \n" $delta_n_down >> result_down.re

   echo " " >> result_down.re
   echo "refractive n for spin down at $w_energy eV" >> result_down.re
   printf "%.3f %.3f %.3f \n" $n11_w_down $n22_w_down $n33_w_down >> result_down.re

   echo " " >> result_down.re
   echo "birefringence for spin down at $w_energy eV"  >> result_down.re
   printf "%.3f \n" $delta_nw_down  >> result_down.re
else
   cd ../
fi