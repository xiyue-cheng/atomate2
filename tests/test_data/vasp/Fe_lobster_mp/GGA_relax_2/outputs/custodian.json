[
    {
        "job": {
            "@module": "custodian.vasp.jobs",
            "@class": "VaspJob",
            "@version": "2023.10.9",
            "vasp_cmd": [
                "mpirun",
                "-np",
                "128",
                "/software/BAM/VASP/5.4.4/bin/vasp_std"
            ],
            "output_file": "vasp.out",
            "stderr_file": "std_err.txt",
            "suffix": "",
            "final": true,
            "backup": true,
            "auto_npar": false,
            "auto_gamma": true,
            "settings_override": null,
            "gamma_vasp_cmd": [
                "vasp_gam"
            ],
            "copy_magmom": false,
            "auto_continue": false
        },
        "corrections": [
            {
                "errors": [
                    "IncorrectSmearing"
                ],
                "actions": [
                    {
                        "dict": "INCAR",
                        "action": {
                            "_set": {
                                "ISMEAR": 2
                            }
                        }
                    },
                    {
                        "dict": "INCAR",
                        "action": {
                            "_set": {
                                "SIGMA": 0.2
                            }
                        }
                    }
                ],
                "handler": {
                    "@module": "custodian.vasp.handlers",
                    "@class": "IncorrectSmearingHandler",
                    "@version": "2023.10.9",
                    "output_filename": "vasprun.xml"
                }
            },
            {
                "errors": [
                    "LargeSigma"
                ],
                "actions": [
                    {
                        "dict": "INCAR",
                        "action": {
                            "_set": {
                                "SIGMA": 0.14
                            }
                        }
                    }
                ],
                "handler": {
                    "@module": "custodian.vasp.handlers",
                    "@class": "LargeSigmaHandler",
                    "@version": "2023.10.9"
                }
            }
        ],
        "handler": null,
        "validator": null,
        "max_errors": false,
        "max_errors_per_job": false,
        "max_errors_per_handler": false,
        "nonzero_return_code": false
    }
]